# Job-finder — environment variables
#
# Copy to `.env` and fill in your own values. Never commit a real `.env`
# (or any token) — this file is a template with placeholder values only.
#
# How each variable is used (see fetch_jobs.py):
#   TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID — send the daily digest to Telegram.
#   INTERNSHIP_MODE — run in internships-only mode (same as --internships).

# Telegram bot token. Create a bot with @BotFather on Telegram and paste
# the token it gives you.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram chat ID the digest is sent to. Message @userinfobot on Telegram
# (or call the Bot API getUpdates endpoint) to find your chat ID.
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Internships-only mode: set to 1 to fetch internships only, 0 (or unset)
# for all matching roles. Same effect as the --internships flag.
INTERNSHIP_MODE=0
